# Copiez ce fichier en `.env` et remplissez UNIQUEMENT si/quand nécessaire.
# Le fichier `.env` est ignoré par Git (voir .gitignore) : les secrets n'y sont jamais versionnés.

# Token Hugging Face (nécessaire plus tard pour télécharger modèle/datasets et pousser le dataset).
# À créer sur https://huggingface.co/settings/tokens  (portée "read", + "write" si vous poussez un dataset).
CHSA_HF_TOKEN=

# Clé Weights & Biases (optionnelle — le suivi d'entraînement a un fallback hors-ligne).
CHSA_WANDB_API_KEY=
